.page {
    min-height: 100vh;
    background: #10141b;
    padding: 24rpx 24rpx 60rpx;
    box-sizing: border-box;
    color: #dbe3ee;
}

.glow {
    position: fixed;
    top: -200rpx;
    left: -120rpx;
    width: 520rpx;
    height: 520rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(106, 169, 233, 0.14) 0%, transparent 70%);
    pointer-events: none;
}

.hhead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin: 8rpx 4rpx 20rpx;
}

.hh-title {
    display: block;
    font-size: 38rpx;
    font-weight: 600;
    color: #f2f6fb;
    letter-spacing: 2rpx;
}

.hh-sub {
    display: block;
    font-size: 21rpx;
    color: #6b7a8d;
    margin-top: 6rpx;
}

.hh-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8rpx;
}

.hh-state {
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 20rpx;
    color: #5fc78f;
}

.hh-state.warn {
    color: #e8b45a;
}

.hh-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: currentColor;
}

.hh-clock {
    font-size: 20rpx;
    color: #6b7a8d;
}

.warnbar {
    background: rgba(232, 180, 90, 0.12);
    border: 1rpx solid rgba(232, 180, 90, 0.3);
    border-radius: 14rpx;
    padding: 16rpx 20rpx;
    font-size: 21rpx;
    color: #e8b45a;
    margin-bottom: 20rpx;
    line-height: 1.5;
}

.card {
    background: rgba(255, 255, 255, 0.035);
    border: 1rpx solid rgba(255, 255, 255, 0.07);
    border-radius: 22rpx;
    padding: 24rpx;
}

/* ---- 顶部切换 ---- */
.tabs {
    display: flex;
    align-items: center;
    margin-bottom: 22rpx;
}

.tab {
    font-size: 28rpx;
    color: #7d8ba0;
    margin-right: 30rpx;
    padding-bottom: 8rpx;
    border-bottom: 4rpx solid transparent;
}

.tab.on {
    color: #f2f6fb;
    font-weight: 600;
    border-bottom-color: #6aa9e9;
}

.tabs-gap {
    flex: 1 1 auto;
}

.dirbox {
    display: flex;
    gap: 12rpx;
}

.dir {
    font-size: 21rpx;
    color: #7d8ba0;
    padding: 8rpx 20rpx;
    border-radius: 100rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.dir.on {
    color: #fff;
    font-weight: 600;
}

.dir.on.up {
    background: rgba(222, 54, 74, 0.35);
    border-color: rgba(222, 54, 74, 0.55);
}

.dir.on.down {
    background: rgba(24, 132, 84, 0.35);
    border-color: rgba(24, 132, 84, 0.55);
}

/* ---- 瓦片 ---- */
.tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.tile {
    border-radius: 16rpx;
    padding: 20rpx 22rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #ffffff;
    min-height: 150rpx;
}

.tile.w-full {
    flex: 1 1 100%;
}

.tile.w-half {
    flex: 1 1 calc(50% - 6rpx);
    min-width: calc(50% - 6rpx);
}

.t-name {
    font-size: 27rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
}

.t-flow {
    font-size: 20rpx;
    opacity: 0.92;
    margin-top: 10rpx;
}

.t-pct {
    font-size: 30rpx;
    font-weight: 700;
    margin-top: 8rpx;
}

.empty {
    text-align: center;
    color: #6b7a8d;
    font-size: 23rpx;
    padding: 60rpx 0;
}

.tip {
    font-size: 19rpx;
    color: #55636f;
    line-height: 1.6;
    margin-top: 22rpx;
    padding: 0 6rpx;
}

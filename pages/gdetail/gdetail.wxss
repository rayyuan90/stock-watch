.page {
    min-height: 100vh;
    background: #10141b;
    padding: 24rpx 24rpx 60rpx;
    box-sizing: border-box;
    color: #dbe3ee;
}

.glow {
    position: fixed;
    top: -200rpx;
    left: -120rpx;
    width: 520rpx;
    height: 520rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(106, 169, 233, 0.14) 0%, transparent 70%);
    pointer-events: none;
}

.hhead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin: 8rpx 4rpx 20rpx;
}

.hh-title {
    display: block;
    font-size: 38rpx;
    font-weight: 600;
    color: #f2f6fb;
    letter-spacing: 2rpx;
}

.hh-sub {
    display: block;
    font-size: 21rpx;
    color: #6b7a8d;
    margin-top: 6rpx;
}

.hh-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4rpx;
}

.q-price {
    font-size: 36rpx;
    font-weight: 700;
}

.q-pct {
    font-size: 22rpx;
}

.up { color: #e2506a; }
.down { color: #34a06a; }

.tabs {
    display: flex;
    align-items: center;
    margin: 0 4rpx 18rpx;
}

.tab {
    font-size: 28rpx;
    color: #7d8ba0;
    margin-right: 30rpx;
    padding-bottom: 8rpx;
    border-bottom: 4rpx solid transparent;
}

.tab.on {
    color: #f2f6fb;
    font-weight: 600;
    border-bottom-color: #6aa9e9;
}

.tabs-gap {
    flex: 1 1 auto;
}

.upd {
    font-size: 20rpx;
    color: #6b7a8d;
}

.card {
    background: rgba(255, 255, 255, 0.035);
    border: 1rpx solid rgba(255, 255, 255, 0.07);
    border-radius: 22rpx;
    padding: 24rpx;
}

.legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10rpx 18rpx;
    margin-bottom: 16rpx;
}

.lg-k {
    font-size: 20rpx;
    color: #6b7a8d;
}

.lg-v {
    font-size: 22rpx;
}

.c-blue { color: #6aa9e9; }
.c-orange { color: #e8a23c; }
.c-gray { color: #9aa8ba; }

.chart {
    width: 100%;
    height: 460rpx;
}

.chart.tall {
    height: 560rpx;
}

.cstate {
    text-align: center;
    color: #9aa8ba;
    font-size: 22rpx;
    padding: 30rpx 0 8rpx;
}

.cstate.cwarn {
    color: #e8b45a;
}

.tip {
    font-size: 19rpx;
    color: #55636f;
    line-height: 1.6;
    margin-top: 22rpx;
    padding: 0 6rpx;
}

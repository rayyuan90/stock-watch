.page {
    position: relative;
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 60rpx;
    background: #0a0e13;
}

.glow {
    position: fixed;
    top: -260rpx;
    left: -160rpx;
    right: -160rpx;
    height: 620rpx;
    background: radial-gradient(circle at 28% 0%, rgba(64, 132, 226, 0.22), rgba(10, 14, 19, 0) 66%);
    pointer-events: none;
    z-index: 0;
}

/* ---------- 顶栏 ---------- */
.topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 12rpx 8rpx 26rpx;
}

.tb-left {
    display: flex;
    flex-direction: column;
}

.tb-title {
    font-size: 42rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
    color: #f2f6fb;
}

.tb-sub {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #5f6c7d;
    letter-spacing: 1rpx;
}

.tb-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.status {
    display: flex;
    align-items: center;
    padding: 6rpx 16rpx;
    border-radius: 100rpx;
    background: rgba(255, 255, 255, 0.05);
}

.status-live {
    background: rgba(255, 77, 79, 0.12);
}

.pulse {
    width: 10rpx;
    height: 10rpx;
    margin-right: 10rpx;
    border-radius: 50%;
    background: #6b7788;
}

.status-live .pulse {
    background: #ff4d4f;
    box-shadow: 0 0 0 0 rgba(255, 77, 79, 0.6);
    animation: pulse 1.6s infinite;
}

@keyframes pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(255, 77, 79, 0.5);
    }

    70% {
        box-shadow: 0 0 0 12rpx rgba(255, 77, 79, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(255, 77, 79, 0);
    }
}

.status-text {
    font-size: 20rpx;
    color: #9aa7b8;
}

.status-live .status-text {
    color: #ff8b8c;
}

.clock {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #4f5b6b;
    letter-spacing: 1rpx;
}

.err {
    position: relative;
    z-index: 1;
    margin-bottom: 20rpx;
    padding: 20rpx 24rpx;
    border-radius: 16rpx;
    background: rgba(255, 77, 79, 0.1);
    color: #ff8b8c;
    font-size: 24rpx;
    line-height: 1.5;
}

.offline-bar {
    position: relative;
    z-index: 1;
    margin-bottom: 20rpx;
    padding: 18rpx 22rpx;
    border: 1rpx solid rgba(255, 180, 84, 0.22);
    border-radius: 16rpx;
    background: rgba(255, 180, 84, 0.07);
}

.ob-row {
    display: flex;
    align-items: center;
}

.ob-dot {
    width: 10rpx;
    height: 10rpx;
    margin-right: 10rpx;
    border-radius: 50%;
    background: #ffb454;
}

.ob-title {
    font-size: 22rpx;
    font-weight: 600;
    color: #ffb454;
}

.ob-sub {
    display: block;
    margin-top: 8rpx;
    font-size: 19rpx;
    color: #8a7042;
    line-height: 1.6;
}

/* 托管预览环境：外部行情被沙箱拦截，属预期行为，用中性色弱化 */
.offline-bar.ob-preview {
    border-color: rgba(108, 155, 255, 0.18);
    background: rgba(108, 155, 255, 0.055);
}

.offline-bar.ob-preview .ob-dot {
    background: #6c9bff;
}

.offline-bar.ob-preview .ob-title {
    color: #9dbaff;
}

.offline-bar.ob-preview .ob-sub {
    color: #7d8ba3;
}

/* ---------- 通用卡片 ---------- */
.card {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 26rpx 26rpx 8rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.055);
    border-radius: 26rpx;
    background: #111721;
}

.sec-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8rpx;
    padding-bottom: 18rpx;
}

.sec-label {
    font-size: 27rpx;
    font-weight: 600;
    color: #dfe7f1;
    letter-spacing: 1rpx;
}

.sec-note {
    font-size: 21rpx;
    color: #4f5b6b;
}

.sec-link {
    font-size: 23rpx;
    color: #6c9bff;
}

/* ---------- 信号卡 ---------- */
.signal {
    padding: 26rpx 26rpx 24rpx;
    background: linear-gradient(152deg, #16202c 0%, #101721 62%, #0e141c 100%);
    border: 1rpx solid rgba(120, 170, 255, 0.13);
}

.signal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.sec-badge {
    padding: 5rpx 16rpx;
    border-radius: 8rpx;
    font-size: 21rpx;
    font-weight: 600;
}

.sec-badge.up {
    background: rgba(255, 77, 79, 0.14);
    color: #ff6b6d;
}

.sec-badge.down {
    background: rgba(23, 201, 100, 0.14);
    color: #2fd67c;
}

.sec-badge.flat {
    background: rgba(255, 255, 255, 0.06);
    color: #8a97a8;
}

.signal-main {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
}

.score {
    width: 190rpx;
    font-size: 76rpx;
    font-weight: 700;
    letter-spacing: -2rpx;
    line-height: 1;
}

.gauge {
    flex: 1;
    padding-right: 6rpx;
}

.gauge-track {
    position: relative;
    height: 10rpx;
    border-radius: 6rpx;
    background: rgba(255, 255, 255, 0.07);
}

.gauge-fill {
    height: 100%;
    border-radius: 6rpx;
    transition: width 0.4s ease;
}

.gauge-fill.up {
    background: linear-gradient(90deg, rgba(255, 77, 79, 0.15), #ff4d4f);
}

.gauge-fill.down {
    background: linear-gradient(90deg, rgba(23, 201, 100, 0.15), #17c964);
}

.gauge-fill.flat {
    background: linear-gradient(90deg, rgba(140, 155, 175, 0.15), #8c9baf);
}

.gauge-dot {
    position: absolute;
    top: -5rpx;
    width: 20rpx;
    height: 20rpx;
    margin-left: -10rpx;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 14rpx rgba(255, 255, 255, 0.5);
    transition: left 0.4s ease;
}

.gauge-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 12rpx;
    font-size: 19rpx;
    color: #46525f;
}

.signal-hint {
    display: block;
    margin-top: 10rpx;
    font-size: 21rpx;
    color: #6f7d8f;
}

.factors {
    display: flex;
    margin-top: 24rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid rgba(255, 255, 255, 0.055);
}

.factor {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    border-left: 1rpx solid rgba(255, 255, 255, 0.045);
}

.factor:first-child {
    border-left: none;
}

.f-name {
    font-size: 20rpx;
    color: #5f6c7d;
}

.f-val {
    margin-top: 6rpx;
    font-size: 30rpx;
    font-weight: 600;
}

.f-detail {
    margin-top: 2rpx;
    font-size: 17rpx;
    color: #3d4854;
}

/* ---------- 主标的 ---------- */
.hero {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 30rpx 26rpx;
    border: 1rpx solid rgba(255, 180, 84, 0.16);
    border-radius: 26rpx;
    background: linear-gradient(158deg, #1d2532 0%, #151d28 58%, #10161f 100%);
    box-shadow: 0 14rpx 44rpx rgba(0, 0, 0, 0.4);
}

.hero-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.hero-title {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.hero-name {
    font-size: 33rpx;
    font-weight: 700;
    color: #f2f6fb;
}

.hero-code {
    margin-top: 8rpx;
    font-size: 20rpx;
    color: #59677a;
}

.hero-price-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.hero-price {
    font-size: 62rpx;
    font-weight: 700;
    letter-spacing: -1rpx;
    line-height: 1.05;
}

.hero-pct {
    margin-top: 6rpx;
    font-size: 24rpx;
    font-weight: 500;
}

.hero-stats {
    display: flex;
    margin-top: 26rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.hs {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.hs-k {
    font-size: 19rpx;
    color: #4f5b6b;
}

.hs-v {
    margin-top: 6rpx;
    font-size: 26rpx;
    color: #c3ccda;
    white-space: nowrap;
}

/* 四栏时末栏（溢价率）靠右，视觉更平衡 */
.hero-stats .hs:last-child {
    align-items: flex-end;
}

.pos {
    display: flex;
    flex-wrap: wrap;
    margin-top: 20rpx;
    padding-top: 18rpx;
    border-top: 1rpx dashed rgba(255, 255, 255, 0.06);
}

.pos-item {
    display: flex;
    width: 50%;
    flex-direction: column;
    margin-bottom: 14rpx;
}

.pos-k {
    font-size: 19rpx;
    color: #4f5b6b;
}

.pos-v {
    margin-top: 4rpx;
    font-size: 25rpx;
    color: #dfe7f1;
}

.pos-empty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    padding: 18rpx 22rpx;
    border-radius: 14rpx;
    background: rgba(255, 255, 255, 0.035);
    font-size: 22rpx;
    color: #6c9bff;
}

.arrow {
    font-size: 26rpx;
}

/* ---------- 行列表 ---------- */
.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 0;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.row:last-child {
    border-bottom: none;
}

.row-l {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
}

.row-name {
    font-size: 27rpx;
    color: #dfe7f1;
}

.row-code {
    margin-top: 5rpx;
    font-size: 19rpx;
    color: #4b5665;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.row-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 190rpx;
}

.row-price {
    font-size: 30rpx;
    font-weight: 600;
}

.row-pct {
    margin-top: 4rpx;
    font-size: 22rpx;
}

.row-profit {
    margin-top: 4rpx;
    font-size: 19rpx;
}

.grp-title {
    margin: 24rpx 0 4rpx;
    padding-left: 14rpx;
    border-left: 4rpx solid #2b3b50;
    font-size: 21rpx;
    color: #5f6c7d;
    letter-spacing: 1rpx;
}

/* ---------- 多空 ---------- */
.ls {
    margin-bottom: 22rpx;
    padding: 22rpx;
    border-radius: 18rpx;
    background: rgba(255, 255, 255, 0.028);
}

.ls-top {
    display: flex;
    justify-content: space-between;
}

.ls-side {
    display: flex;
    flex-direction: column;
}

.ls-side.right {
    align-items: flex-end;
}

.ls-k {
    font-size: 19rpx;
    color: #4f5b6b;
}

.ls-v {
    margin-top: 6rpx;
    font-size: 30rpx;
    font-weight: 600;
}

.ls-bar {
    display: flex;
    height: 14rpx;
    margin-top: 18rpx;
    overflow: hidden;
    border-radius: 8rpx;
    background: rgba(255, 255, 255, 0.05);
}

.ls-long {
    height: 100%;
    background: linear-gradient(90deg, #ff4d4f, #ff7a7c);
}

.ls-short {
    height: 100%;
    background: linear-gradient(90deg, #17c964, #0fa855);
}

.ls-legend {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12rpx;
    font-size: 19rpx;
}

.ls-note {
    color: #46525f;
}

.ls-empty {
    margin-bottom: 22rpx;
    padding: 26rpx 22rpx;
    border: 1rpx dashed rgba(108, 155, 255, 0.28);
    border-radius: 18rpx;
    background: rgba(108, 155, 255, 0.05);
}

.ls-empty-title {
    display: block;
    font-size: 24rpx;
    color: #8fb2ff;
}

.ls-empty-sub {
    display: block;
    margin-top: 8rpx;
    font-size: 20rpx;
    color: #4f5b6b;
    line-height: 1.5;
}

/* ---------- 期货表 ---------- */
.fut-table {
    margin-top: 6rpx;
}

.ft-head {
    display: flex;
    padding: 0 0 14rpx;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
    font-size: 18rpx;
    color: #3f4a57;
}

.ft-h1 {
    width: 150rpx;
}

.ft-h2 {
    flex: 1;
    text-align: center;
}

.ft-h3 {
    flex: 1;
    text-align: right;
}

.ft-row {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.035);
}

.ft-row:last-child {
    border-bottom: none;
}

.ft-name {
    display: flex;
    width: 150rpx;
    flex-direction: column;
}

.ft-code {
    font-size: 26rpx;
    font-weight: 700;
    color: #ffb454;
    letter-spacing: 1rpx;
}

.ft-desc {
    margin-top: 3rpx;
    font-size: 18rpx;
    color: #4b5665;
}

.ft-price {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
}

.ft-p {
    font-size: 27rpx;
    font-weight: 600;
}

.ft-pct {
    margin-top: 3rpx;
    font-size: 20rpx;
}

.ft-basis {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-end;
}

.ft-b {
    font-size: 21rpx;
}

.ft-vol {
    margin-top: 3rpx;
    font-size: 18rpx;
    color: #46525f;
}

/* ---------- 底部 ---------- */
.footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30rpx 20rpx 10rpx;
    font-size: 19rpx;
    color: #39434f;
    line-height: 1.9;
    text-align: center;
}

.footer .warn {
    color: #4a3f2e;
}

/* ---------- 加载 ---------- */
.loading-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 14, 19, 0.92);
}

.loading-box {
    display: flex;
    align-items: center;
    flex-direction: column;
    color: #6f7d8f;
    font-size: 23rpx;
}

.spinner {
    width: 42rpx;
    height: 42rpx;
    margin-bottom: 20rpx;
    border: 4rpx solid rgba(108, 155, 255, 0.18);
    border-top-color: #6c9bff;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* ---------- 可点击行 + 盘前盘后 ---------- */
.tap {
    position: relative;
}

.tap:active {
    background: rgba(255, 255, 255, 0.045);
}

.ext-line {
    margin-top: 5rpx;
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.ext {
    font-size: 19rpx;
    padding: 2rpx 10rpx;
    border-radius: 100rpx;
    background: rgba(255, 255, 255, 0.05);
}

.ext.up {
    color: #ff6b6d;
    background: rgba(255, 77, 79, 0.12);
}

.ext.down {
    color: #2fd67c;
    background: rgba(23, 201, 100, 0.12);
}

.ext-none {
    font-size: 19rpx;
    color: #4b5665;
}

/* ---------- 域名未配置提示 ---------- */
.domain-tip {
    margin-bottom: 18rpx;
    padding: 20rpx 22rpx;
    border-radius: 18rpx;
    background: rgba(230, 184, 76, 0.09);
    border: 1rpx solid rgba(230, 184, 76, 0.28);
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.dt-t {
    font-size: 24rpx;
    color: #e6b84c;
    font-weight: 600;
}

.dt-s {
    font-size: 20rpx;
    color: #9c8a5d;
}

.dt-list {
    font-size: 19rpx;
    line-height: 1.7;
    color: #c9b47a;
    word-break: break-all;
}

.dt-actions {
    margin-top: 4rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12rpx;
}

.dt-btn {
    font-size: 21rpx;
    color: #0a0e13;
    background: #e6b84c;
    padding: 8rpx 20rpx;
    border-radius: 100rpx;
}

.dt-hint {
    font-size: 18rpx;
    color: #7d6f4a;
}

/* ---------- 自选 ---------- */
.head-links {
    display: flex;
    align-items: center;
    gap: 22rpx;
}

.watch-empty {
    display: flex;
    flex-direction: column;
    margin-bottom: 14rpx;
    padding: 26rpx 22rpx;
    border: 1rpx dashed rgba(108, 155, 255, 0.28);
    border-radius: 18rpx;
    background: rgba(108, 155, 255, 0.05);
}

.we-t {
    font-size: 25rpx;
    color: #a9c2ea;
}

.we-s {
    margin-top: 10rpx;
    font-size: 20rpx;
    color: #56637a;
    line-height: 1.6;
}

.watch-foot {
    padding: 14rpx 0 18rpx;
    font-size: 19rpx;
    color: #3f4a58;
    text-align: center;
}

/* ---------- A股量能卡 ---------- */
.flow-grid {
    display: flex;
    justify-content: space-between;
    padding: 6rpx 0 4rpx;
}

.fg-cell {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
}

.fg-cell:first-child {
    align-items: flex-start;
}

.fg-cell:last-child {
    align-items: flex-end;
}

.fg-k {
    font-size: 20rpx;
    color: #5f6c7d;
}

.fg-v {
    margin-top: 8rpx;
    font-size: 31rpx;
    font-weight: 700;
    color: #e9f0f8;
}

.flow-bar {
    position: relative;
    margin-top: 22rpx;
    height: 14rpx;
    border-radius: 100rpx;
    background: rgba(255, 255, 255, 0.06);
}

.fb-fill {
    height: 100%;
    border-radius: 100rpx;
    background: linear-gradient(90deg, #2f6bd8, #6c9bff);
    transition: width 0.4s ease;
}

/* 同刻量能已超过昨日 → 暖色，满格也能看出放量 */
.fb-fill.hot {
    background: linear-gradient(90deg, #d8483f, #ff8a5c);
}

.fb-mark {
    position: absolute;
    top: -6rpx;
    width: 2rpx;
    height: 26rpx;
    background: rgba(255, 255, 255, 0.65);
}

.flow-note {
    display: block;
    margin-top: 12rpx;
    font-size: 20rpx;
    color: #56637a;
}

/* ---------- 净空单（中信 vs 前20） ---------- */
.pos-box {
    margin-top: 26rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.pos-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
}

.pos-label {
    font-size: 24rpx;
    color: #a9c2ea;
}

.pos-date {
    font-size: 19rpx;
    color: #414c5a;
}

.pos-tabs {
    display: flex;
    gap: 12rpx;
    margin-top: 16rpx;
    flex-wrap: wrap;
}

.pos-tab {
    font-size: 20rpx;
    padding: 6rpx 16rpx;
    border-radius: 100rpx;
    background: rgba(255, 255, 255, 0.05);
    color: #6b7889;
}

.pos-tab.on {
    background: rgba(108, 155, 255, 0.16);
    color: #9cc0ff;
}

.pos-legend {
    display: flex;
    align-items: center;
    gap: 20rpx;
    margin-top: 14rpx;
}

.pl-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 19rpx;
    color: #7d8a9b;
}

.pl-dot {
    width: 16rpx;
    height: 16rpx;
    border-radius: 4rpx;
    background: #ff6b6d;
}

.pl-dot.half {
    opacity: 0.45;
}

.pl-note {
    margin-left: auto;
    font-size: 18rpx;
    color: #3f4a58;
}

.pos-canvas {
    width: 100%;
    height: 320rpx;
    margin-top: 10rpx;
}

.pos-msg {
    padding: 20rpx 0 8rpx;
    font-size: 21rpx;
    color: #56637a;
    text-align: center;
}

.pos-msg.err {
    color: #d8a04a;
}

.pos-pick {
    padding: 12rpx 0 2rpx;

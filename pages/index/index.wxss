}

.pl-line.c {
    background: #6c9bff;
}

.pl-line.t {
    background: #ffd166;
}

.pos-subnote {
    margin-top: 6rpx;
    font-size: 18rpx;
    color: #3f4a58;
}

.sync-tag {
    font-size: 19rpx;
    padding: 3rpx 12rpx;
    border-radius: 100rpx;
    background: rgba(255, 255, 255, 0.06);

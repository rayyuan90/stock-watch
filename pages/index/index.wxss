}

/* ---------- 多空博弈（ASFMM-A / SFMM） ---------- */
.bg-top {
    display: flex;
    gap: 16rpx;
    margin-bottom: 20rpx;
}

.bg-quad {
    flex: 1.2;
    padding: 18rpx 20rpx;
    border-radius: 16rpx;
    display: flex;
    flex-direction: column;
}

.bg-quad-t {
    font-size: 28rpx;
    font-weight: 700;
}

.bg-quad-s {
    margin-top: 6rpx;
    font-size: 20rpx;
    opacity: 0.85;
}

.bg-q1 { background: rgba(255, 93, 93, 0.12); color: #ff8080; }
.bg-q2 { background: rgba(255, 180, 84, 0.12); color: #ffbe6b; }
.bg-q3 { background: rgba(53, 192, 138, 0.12); color: #52cf9d; }
.bg-q4 { background: rgba(108, 155, 255, 0.12); color: #8fb0ff; }

.bg-pred {
    flex: 1;
    padding: 18rpx 20rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.bg-pred-label {
    font-size: 19rpx;
    color: #7d8ba3;
}

.bg-pred-v {
    margin-top: 8rpx;
    font-size: 24rpx;
    font-weight: 700;
}

.bg-pred.up { color: #ff8080; }
.bg-pred.down { color: #52cf9d; }
.bg-pred.flat { color: #b9c4d6; }

/* v3 脉冲市：量能状态机配色 */
.bg-regime-starve { background: rgba(122, 140, 170, 0.16); color: #b7c3d8; }
.bg-regime-pulse { background: rgba(255, 180, 84, 0.14); color: #ffbe6b; }
.bg-regime-sustain { background: rgba(255, 93, 93, 0.13); color: #ff8080; }
.bg-regime-dump { background: rgba(53, 192, 138, 0.13); color: #52cf9d; }
.bg-regime-neutral { background: rgba(108, 155, 255, 0.12); color: #8fb0ff; }

.bg-pred.gate-good { color: #ff8080; }
.bg-pred.gate-mid { color: #ffbe6b; }
.bg-pred.gate-bad { color: #52cf9d; }

/* 量能读数两行 */
.bg-regime-row {
    display: flex;
    flex-direction: column;
    margin-bottom: 14rpx;
    padding: 12rpx 18rpx;
    border-radius: 10rpx;
    background: rgba(255, 255, 255, 0.03);
}

.bg-regime-i {
    font-size: 20rpx;
    line-height: 1.65;
    color: #a9b6cc;
}

.bg-regime-i.jump-on { color: #ffbe6b; }

/* T+1 / T+2 双确认 */
.bg-conn {
    margin-bottom: 14rpx;
    padding: 12rpx 18rpx;
    border-radius: 10rpx;
    background: rgba(255, 255, 255, 0.03);
    border-left: 4rpx solid rgba(143, 176, 255, 0.5);
}

.bg-conn.ok { background: rgba(255, 93, 93, 0.10); border-left-color: #ff8080; }
.bg-conn.warn { background: rgba(255, 180, 84, 0.10); border-left-color: #ffbe6b; }

.bg-conn-t {
    display: block;
    font-size: 21rpx;
    color: #d6e0f2;
    font-weight: 600;
    margin-bottom: 4rpx;
}

.bg-conn-d {
    display: block;
    font-size: 20rpx;
    line-height: 1.6;
    color: #97a5bd;
}

/* 六条门禁 */
.bg-gates {
    margin-bottom: 16rpx;
    padding: 14rpx 18rpx;
    border-radius: 10rpx;
    background: rgba(255, 255, 255, 0.03);
}

.bg-gates-t {
    display: block;
    font-size: 21rpx;
    font-weight: 600;
    color: #d6e0f2;
    margin-bottom: 10rpx;
}

.bg-gchip {
    display: flex;
    align-items: flex-start;
    padding: 7rpx 12rpx;
    margin-bottom: 6rpx;
    border-radius: 8rpx;
    background: rgba(255, 255, 255, 0.03);
}

.bg-gchip.pass { background: rgba(255, 93, 93, 0.10); }
.bg-gchip.fail { background: rgba(120, 132, 152, 0.12); }

.bg-gchip-n {
    width: 190rpx;
    flex-shrink: 0;
    font-size: 20rpx;
    color: #b7c3d8;
}

.bg-gchip.pass .bg-gchip-n { color: #ffb0b0; }
.bg-gchip.fail .bg-gchip-n { color: #8d9aae; }

.bg-gchip-d {
    flex: 1;
    font-size: 19rpx;
    line-height: 1.5;
    color: #93a1b8;
}

.bg-mrow {
    display: flex;
    align-items: center;
    margin-bottom: 18rpx;
}

.bg-mlabel {
    width: 150rpx;
    font-size: 21rpx;
    color: #9aa7bd;
}

.bg-mtrack {
    position: relative;
    flex: 1;
    height: 14rpx;
    border-radius: 8rpx;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
}

.bg-mmark {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2rpx;
    height: 100%;
    background: rgba(255, 255, 255, 0.35);
    z-index: 2;
}

.bg-mfill {
    height: 100%;
    border-radius: 8rpx;
}

.bg-mfill.up { background: linear-gradient(90deg, #c0392b, #ff8080); }
.bg-mfill.down { background: linear-gradient(90deg, #1e8e5e, #52cf9d); }
.bg-mfill.flat { background: #6c7a92; }

.bg-mval {
    width: 90rpx;
    text-align: right;
    font-size: 22rpx;
    font-weight: 700;
}

.bg-mval.up { color: #ff8080; }
.bg-mval.down { color: #52cf9d; }
.bg-mval.flat { color: #b9c4d6; }

.bg-bars {
    margin-bottom: 16rpx;
}

.bg-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10rpx;
}

.bg-bnote {
    width: 100%;
    margin-top: 2rpx;
    font-size: 19rpx;
    line-height: 1.5;
    color: #7d8aa3;
    word-break: break-all;
}

.bg-blabel {
    width: 170rpx;
    font-size: 20rpx;
    color: #9aa7bd;
}

.bg-btrack {
    position: relative;
    flex: 1;
    height: 10rpx;
    border-radius: 6rpx;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
}

.bg-bmid {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2rpx;
    height: 100%;
    background: rgba(255, 255, 255, 0.25);
}

.bg-bfill {
    height: 100%;
    border-radius: 6rpx;
    background: #6c9bff;
}

.bg-bfill.neg { background: #ffb454; }

.bg-bval {
    width: 140rpx;
    text-align: right;
    font-size: 20rpx;
    color: #c7d1e2;
}

.bg-matrix {
    margin-bottom: 14rpx;
    font-size: 21rpx;
    color: #8fb0ff;
}

/* v2 数据质量闸门横幅 */
.bg-quality {
    margin-bottom: 14rpx;
    padding: 12rpx 18rpx;
    border-radius: 10rpx;
    font-size: 21rpx;
    line-height: 1.5;
}
.bg-quality.qok {
    background: rgba(46, 160, 100, 0.12);
    color: #6fd8a0;
}
.bg-quality.qbad {
    background: rgba(224, 90, 90, 0.14);
    color: #ff9c9c;
}

/* 政策向量行 */
.bg-policy {
    margin-bottom: 14rpx;
    font-size: 21rpx;
    color: #e0b96a;
    line-height: 1.5;
}

/* 次日三场景推演 */
.bg-scen {
    margin-bottom: 14rpx;
    padding: 12rpx 18rpx;
    background: rgba(143, 176, 255, 0.08);
    border-radius: 10rpx;
}
.bg-scen-t {
    display: block;
    font-size: 21rpx;
    color: #8fb0ff;
    margin-bottom: 6rpx;
}
.bg-scen-i {
    display: block;
    font-size: 21rpx;
    color: #c6d4f0;
    line-height: 1.6;
    margin-bottom: 4rpx;
}

.bg-alerts {
    display: flex;
    flex-direction: column;
    margin-bottom: 14rpx;
}

.bg-alert {
    font-size: 20rpx;
    line-height: 1.7;
    color: #d8b26a;
}

.bg-note {
    border-top: 1rpx solid rgba(255, 255, 255, 0.05);
    padding-top: 14rpx;
    font-size: 18rpx;
    color: #6d7a90;
    line-height: 1.6;
}

/* ---------- 模型预测复盘 ---------- */
.bgacc-stats {
    display: flex;
    gap: 24rpx;
    margin-bottom: 16rpx;
}

.bgacc-stat {
    font-size: 21rpx;
    color: #9aa7bd;
}

.bgacc-stat .num {
    color: #e8eef7;
    font-weight: 700;
}

.bgacc-canvas {
    width: 100%;
    height: 320rpx;
    display: block;
}

/* ---------- 明日实操验证 ---------- */
.vf-item {
    border-left: 4rpx solid #6c7a92;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12rpx;
    padding: 16rpx 20rpx;
    margin-bottom: 16rpx;
}

.vf-item.vf-ok { border-left-color: #ff6b6d; }
.vf-item.vf-bad { border-left-color: #2fd67c; }
.vf-item.vf-warn { border-left-color: #ffb454; }
.vf-item.vf-pending { border-left-color: #6c7a92; opacity: 0.85; }

.vf-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10rpx;
}

.vf-title {
    font-size: 22rpx;
    color: #c7d1e2;
    font-weight: 700;
}

.vf-badge {
    font-size: 20rpx;
    font-weight: 700;
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.08);
    color: #b9c4d6;
}

.vf-ok .vf-badge { background: rgba(255, 107, 109, 0.15); color: #ff8080; }
.vf-bad .vf-badge { background: rgba(47, 214, 124, 0.15); color: #52cf9d; }
.vf-warn .vf-badge { background: rgba(255, 180, 84, 0.15); color: #ffbe6b; }

.vf-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6rpx 0;
}

.vf-k {
    font-size: 20rpx;
    color: #8a97ad;
}

.vf-v {
    font-size: 21rpx;
    color: #e8eef7;
}

.vf-v.up { color: #ff8080; }
.vf-v.down { color: #52cf9d; }
.vf-v.flat { color: #b9c4d6; }

/* ---------- 今日验证结论横幅 ---------- */
.vf-verdict {
    border-radius: 14rpx;
    padding: 16rpx 20rpx;
    margin-bottom: 18rpx;
    background: rgba(255, 255, 255, 0.04);
    border-left: 4rpx solid #6c7a92;
}

.vf-verdict.vf-verdict-ok { border-left-color: #ff6b6d; background: rgba(255, 107, 109, 0.08); }
.vf-verdict.vf-verdict-bad { border-left-color: #2fd67c; background: rgba(47, 214, 124, 0.08); }
.vf-verdict.vf-verdict-warn { border-left-color: #ffb454; background: rgba(255, 180, 84, 0.08); }
.vf-verdict.vf-verdict-pending { border-left-color: #6c7a92; opacity: 0.85; }

.vf-verdict-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.vf-verdict-k {
    font-size: 20rpx;
    color: #8a97ad;
}

.vf-verdict-v {
    font-size: 24rpx;
    font-weight: 700;
    color: #b9c4d6;
}

.vf-verdict-ok .vf-verdict-v { color: #ff8080; }
.vf-verdict-bad .vf-verdict-v { color: #52cf9d; }
.vf-verdict-warn .vf-verdict-v { color: #ffbe6b; }

.vf-verdict-detail {
    display: block;
    margin-top: 8rpx;
    font-size: 19rpx;
    color: #8a97ad;
    line-height: 1.6;
}

/* ---------- 跨市场 × A股模型 汇总行 ---------- */
.sig-fuse {
    border-top: 1rpx solid rgba(255, 255, 255, 0.06);
    margin-top: 16rpx;
    padding-top: 14rpx;
}

.sf-row {
    display: flex;
    align-items: center;
    gap: 14rpx;
}

.sf-k {
    flex: 1;
    font-size: 20rpx;
    color: #8a97ad;
}

.sf-score {
    font-size: 26rpx;
    font-weight: 700;
}

.sf-score.up { color: #ff6b6d; }
.sf-score.down { color: #2fd67c; }
.sf-score.flat { color: #b9c4d6; }

.sf-label {
    font-size: 21rpx;
    font-weight: 700;
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.08);
    color: #b9c4d6;
}

.sig-fuse-up .sf-label { background: rgba(255, 107, 109, 0.15); color: #ff8080; }
.sig-fuse-down .sf-label { background: rgba(47, 214, 124, 0.15); color: #52cf9d; }

.sf-hint {
    display: block;
    margin-top: 8rpx;
    font-size: 19rpx;
    color: #6d7a90;
    line-height: 1.6;
}

/* ---- 全球市场入口（新增模块，不改动原有卡片） ---- */
.tb-subrow {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 14rpx;
    margin-top: 12rpx;
}

.tb-subrow .tb-sub {
    margin-top: 0;
}

/* 四个胶囊（全球市场/热力图/资金四类/交易中）统一尺寸，禁止换行 */
.tb-global {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 20rpx;
    line-height: 1;
    color: #6aa9e9;
    padding: 9rpx 18rpx;
    border-radius: 100rpx;
    border: 1rpx solid rgba(106, 169, 233, 0.35);
    background: rgba(106, 169, 233, 0.1);
    letter-spacing: 1rpx;
}

.tb-global:active {
    background: rgba(106, 169, 233, 0.22);
}

/* 「交易中」状态胶囊：与左侧三枚同高同字号，颜色保持红色系 */
.status-inline {
    flex: 0 0 auto;
    padding: 9rpx 18rpx;
    border: 1rpx solid transparent;
    margin-top: 0;
}

.status-inline .pulse {
    width: 10rpx;
    height: 10rpx;
    margin-right: 8rpx;
}

.status-inline .status-text {
    font-size: 20rpx;
    line-height: 1;
}

<view class="page">
    <view class="glow"></view>

    <view class="topbar">
        <view class="tb-left">
            <text class="tb-title">算力看盘</text>
            <text class="tb-sub">中韩半导体 · 跨市场联动</text>
            <view class="tb-subrow">
                <text class="tb-global" bindtap="goGlobal">全球市场</text>
                <text class="tb-global" bindtap="goHeat">热力图</text>
                <text class="tb-global" bindtap="goMflow">资金四类</text>
                <view class="status status-inline {{live ? 'status-live' : ''}}">
                    <view class="pulse"></view>
                    <text class="status-text">{{statusText}}</text>
                </view>
            </view>
        </view>
        <view class="tb-right">
            <text class="clock num">{{updatedAt}}</text>
        </view>
    </view>

    <view class="err" wx:if="{{error}}">{{error}}，请检查网络或接口域名白名单</view>

    <view class="offline-bar {{previewMode ? 'ob-preview' : ''}}" wx:if="{{offline}}">
        <view class="ob-row">
            <text class="ob-dot"></text>
            <text class="ob-title">{{previewMode ? '预览快照' : '离线快照'}} · {{offlineAt}}</text>
        </view>
        <text class="ob-sub">{{offlineSub}}</text>
    </view>

    <view class="domain-tip" wx:if="{{domainBlocked}}">
        <text class="dt-t">微信拦截了行情请求：域名未加白名单</text>
        <text class="dt-s">需要加入 request 合法域名：</text>
        <text class="dt-list num">{{domainText}}</text>
        <view class="dt-actions">
            <text class="dt-btn" bindtap="copyDomains">复制全部域名</text>
            <text class="dt-hint">临时办法：右上角「…」→ 打开调试</text>
        </view>
    </view>

    <view class="card">
        <view class="sec-head">
            <view class="fold-hit" bindtap="toggleModule" data-key="hkTech">
                <text class="fold-arrow">{{collapsed.hkTech ? '展开 ▼' : '收起 ▲'}}</text>
                <text class="sec-label">港股科技板块</text>
            </view>
            <text class="sec-note">恒科指数 · 默认 5 只 · 点行看日K分时</text>
        </view>

        <view class="module-body" hidden="{{collapsed.hkTech}}">
        <view class="row tap" bindtap="goDetail" data-sec="124.HSTECH" data-name="恒生科技指数">
            <view class="row-l">
                <text class="row-name">恒生科技指数</text>
                <text class="row-code num">HSTECH · 港股</text>
            </view>
            <view class="row-r">
                <text class="row-price num {{hstechRow.cls}}">{{hstechRow.priceText}}</text>
                <text class="row-pct num {{hstechRow.cls}}">{{hstechRow.pctText}}</text>
            </view>
        </view>

        <view class="row tap" wx:for="{{hkTech}}" wx:key="code" wx:if="{{item.primary || hkTechExpanded}}" bindtap="goDetail" data-sec="{{item.sec}}" data-name="{{item.name}}">
            <view class="row-l">
                <text class="row-name">{{item.name}}</text>
                <text class="row-code num">{{item.code}} · 港元</text>
            </view>
            <view class="row-r">
                <text class="row-price num {{item.cls}}">{{item.priceText}}</text>
                <text class="row-pct num {{item.cls}}">{{item.pctText}}</text>
            </view>
        </view>

        <view class="hk-more" bindtap="toggleHkTechMore">
            <text>{{hkTechExpanded ? '收起 ▲' : '更多 ▼'}}</text>
        </view>

        <view class="hk-sub" wx:if="{{hkAnalysis}}">
            <view class="signal-head">
                <text class="hk-sub-title">港股次日倾向</text>
                <text class="sec-badge {{hkAnalysis.cls}}">{{hkAnalysis.label}}</text>
            </view>
            <view class="signal-main">
                <text class="score num {{hkAnalysis.cls}}">{{hkAnalysis.scoreText}}</text>
                <view class="gauge">
                    <view class="gauge-track">
                        <view class="gauge-fill {{hkAnalysis.cls}}" style="width:{{hkAnalysis.barPct}}%"></view>
                        <view class="gauge-dot {{hkAnalysis.cls}}" style="left:{{hkAnalysis.barPct}}%"></view>
                    </view>
                    <view class="gauge-axis">
                        <text>偏空</text>
                        <text>震荡</text>
                        <text>偏多</text>
                    </view>
                    <text class="signal-hint">{{hkAnalysis.hint}}</text>
                </view>
            </view>
            <view class="factors">
                <view class="factor" wx:for="{{hkAnalysis.factors}}" wx:key="name">
                    <text class="f-name">{{item.name}}</text>
                    <text class="f-val num {{item.cls}}">{{item.text}}</text>
                    <text class="f-detail">{{item.detail}}</text>
                </view>
            </view>
            <text class="hk-note">{{hkAnalysis.note}}</text>
        </view>
        </view>
    </view>

    <!-- 港股科技 · 底部研判（三层底 / 底部概率 / 信号清单） -->
    <view class="card hkb" wx:if="{{hkBottom}}">
        <view class="sec-head hkb-head">
            <view class="fold-hit" bindtap="toggleModule" data-key="hkb">
                <text class="fold-arrow">{{collapsed.hkb ? '展开 ▼' : '收起 ▲'}}</text>
                <view class="hkb-head-l">
                    <text class="sec-label">港股科技 · 底部研判</text>
                    <text class="sec-note" wx:if="{{hkBottom.dataTag}}">{{hkBottom.dataTag}} · {{hkBottom.snapTag}} · 基准 {{hkBottom.asOf}}</text>
                    <text class="sec-note" wx:else>{{hkBottom.period}} · 估值底/资金底/叙事底 · 基准 {{hkBottom.asOf}}</text>
                </view>
            </view>
            <text class="hkb-toggle" catchtap="toggleHkBottom">{{hkBottomOpen ? '概括 ▲' : '详细 ▼'}}</text>
        </view>

        <view class="module-body" hidden="{{collapsed.hkb}}">
        <!-- 概览：综合概率 + 三层底状态（常显） -->
        <view class="hkb-hero">
            <view class="hkb-prob-wrap">
                <text class="hkb-prob-label">底部综合概率</text>
                <text class="hkb-prob num {{hkBottom.cls}}">{{hkBottom.probText}}</text>
                <text class="hkb-verdict {{hkBottom.cls}}">{{hkBottom.label}} · {{hkBottom.layerCount}}</text>
            </view>
            <view class="hkb-gauge">
                <view class="hkb-track">
                    <view class="hkb-fill {{hkBottom.cls}}" style="width:{{hkBottom.barPct}}%"></view>
                    <view class="hkb-mark" style="left:33%"></view>
                    <view class="hkb-mark" style="left:66%"></view>
                </view>
                <view class="hkb-axis"><text>底部未到</text><text>左侧磨底</text><text>确认大底</text></view>
            </view>
        </view>
        <text class="hkb-summary">{{hkBottom.verdict}}</text>

        <view class="hkb-layers">
            <view class="hkb-layer hkb-layer-{{item.statusCls}}" wx:for="{{hkBottom.layers}}" wx:key="key">
                <view class="hkb-layer-top">
                    <text class="hkb-layer-name">{{item.name}}</text>
                    <text class="hkb-layer-state">{{item.status}}</text>
                    <text class="hkb-layer-w">权重 {{item.weight}}%</text>
                </view>
                <view class="hkb-layer-bar"><view class="hkb-layer-fill" style="width:{{item.progress}}%"></view></view>
                <text class="hkb-layer-line">{{item.oneLine}}</text>
            </view>
        </view>

        <!-- 展开明细：坐标 / 逐层证据 / A-B-C 信号清单 -->
        <view class="hkb-detail" wx:if="{{hkBottomOpen}}">
            <view class="hkb-block">
                <view class="hkb-block-t">一、当下坐标（钉死位置）</view>
                <view class="hkb-anchor">
                    <view class="hkb-anchor-cell" wx:for="{{hkBottom.anchorRows}}" wx:key="k">
                        <text class="hac-k">{{item.k}}</text>
                        <text class="hac-v num">{{item.v}}</text>
                        <text class="hac-n" wx:if="{{item.note}}">{{item.note}}</text>
                    </view>
                </view>
            </view>

            <view class="hkb-block">
                <view class="hkb-block-t">二、三层底 · 逐层证据</view>
                <view class="hkb-ev" wx:for="{{hkBottom.layers}}" wx:key="key">
                    <view class="hkb-ev-head">
                        <text class="hkb-ev-name hkb-layer-{{item.statusCls}}">{{item.name}}</text>
                        <text class="hkb-ev-badge hkb-layer-{{item.statusCls}}">{{item.status}} · 到达 {{item.progress}}%</text>
                    </view>
                    <view class="hkb-ev-line" wx:for="{{item.points}}" wx:for-item="pt" wx:key="*this">
                        <text class="hkb-dot">·</text><text class="hkb-ev-text">{{pt}}</text>
                    </view>
                    <view class="hkb-caveat"><text>{{item.caveat}}</text></view>
                </view>
            </view>

            <view class="hkb-block">
                <view class="hkb-block-t">三、底部信号清单（逐日 / 逐季可验证）</view>
                <view class="hkb-tabs">
                    <text class="hkb-tab {{hkBottomTab === item.key ? 'on' : ''}}"
                          wx:for="{{hkBottom.signals}}" wx:key="key"
                          data-tab="{{item.key}}" bindtap="switchHkBottomTab">{{item.key}} 类</text>
                </view>
                <block wx:for="{{hkBottom.signals}}" wx:key="key">
                    <view class="hkb-sig" wx:if="{{hkBottomTab === item.key}}">
                        <view class="hkb-sig-title">{{item.title}} <text class="hkb-sig-sub">{{item.sub}}</text></view>
                        <view class="hkb-sig-row hkb-sig-head-row">
                            <text class="hsr-name">信号</text>
                            <text class="hsr-now">当前状态</text>
                            <text class="hsr-thr">见底阈值</text>
                        </view>
                        <view class="hkb-sig-row" wx:for="{{item.items}}" wx:for-item="sig" wx:key="name">
                            <text class="hsr-name">{{sig.name}}</text>
                            <text class="hsr-now">{{sig.now}}</text>
                            <text class="hsr-thr">{{sig.threshold}}</text>
                        </view>
                        <view class="hkb-sig-note" wx:if="{{item.note}}"><text>{{item.note}}</text></view>
                    </view>
                </block>
            </view>

            <view class="hkb-foot">
                概率 = 三层底加权到达度，数据驱动自动重算 · 实时项：恒科行情 / 南向连续净流入与月度累计 / 腾讯财报现金流 · 快照项：估值分位 / 外资持仓 / 资本开支细项 / ETF 折价 / 美债，锁定在各自报告期（基准 {{hkBottom.asOf}}），需手动更新数值 · 非投资建议
            </view>
        </view>
        </view>
    </view>

    <view class="card">
        <view class="sec-head">
            <view class="fold-hit" bindtap="toggleModule" data-key="aflow">
                <text class="fold-arrow">{{collapsed.aflow ? '展开 ▼' : '收起 ▲'}}</text>
                <text class="sec-label">A 股量能</text>
            </view>
            <text class="sec-link" bindtap="goVolume">对比曲线与60日量能 ›</text>
        </view>

        <view class="module-body" hidden="{{collapsed.aflow}}">
        <view class="flow-grid" wx:if="{{aFlow}}">
            <view class="fg-cell">
                <text class="fg-k">今日两市</text>
                <text class="fg-v num">{{aFlow.todayText}}</text>
            </view>
            <view class="fg-cell">
                <text class="fg-k">{{aFlow.baseLabel}}</text>
                <text class="fg-v num">{{aFlow.baseText}}</text>
            </view>
            <view class="fg-cell">
                <text class="fg-k">同刻对比</text>
                <text class="fg-v num {{aFlow.ratioCls}}">{{aFlow.ratioText}}</text>
            </view>
        </view>

        <view class="flow-bar" wx:if="{{aFlow}}">
            <view class="fb-fill {{aFlow.hot ? 'hot' : ''}}" style="width:{{aFlow.barPct}}%"></view>
            <view class="fb-mark" style="left:{{aFlow.timeMark}}%"></view>
        </view>
        <text class="flow-note" wx:if="{{aFlow}}">{{aFlow.note}}</text>
        <text class="flow-note" wx:else>两市成交额获取中…</text>
        </view>
    </view>

    <view class="card" wx:if="{{aGame || aGameState}}">
        <view class="sec-head">
            <view class="fold-hit" bindtap="toggleModule" data-key="agame">
                <text class="fold-arrow">{{collapsed.agame ? '展开 ▼' : '收起 ▲'}}</text>
                <text class="sec-label">A股多空博弈</text>
            </view>
            <text class="sec-note">ASFMM-A v3 · 脉冲市状态机</text>
        </view>

        <view class="module-body" hidden="{{collapsed.agame}}">
        <view class="pos-msg" wx:if="{{!aGame}}">
            <text>{{aGameState}}</text>
        </view>
        <view wx:if="{{aGame}}">
            <view class="bg-top">
                <view class="bg-quad bg-regime-{{aGame.regimeCls}}">
                    <text class="bg-quad-t">{{aGame.regime.label}}</text>
                    <text class="bg-quad-s">{{aGame.action}}</text>
                </view>
                <view class="bg-pred gate-{{aGame.gateCls}}">
                    <text class="bg-pred-label">买点门禁</text>
                    <text class="bg-pred-v num">{{aGame.gateScore}}/6</text>
                </view>
            </view>

            <view class="bg-regime-row">
                <text class="bg-regime-i">今日量能 {{aGame.amtText}} · {{aGame.rMaText}} · {{aGame.rPrevText}}</text>
                <text class="bg-regime-i">20日均量 {{aGame.ma20Text}} · 连续站上 {{aGame.regime.consec}} 日 · {{aGame.regime.reason}}</text>
                <text class="bg-regime-i {{aGame.jump.triggered ? 'jump-on' : ''}}">跳变监测: {{aGame.jump.text}}</text>
            </view>

            <view class="bg-conn {{aGame.cont.verdict === '双确认通过' ? 'ok' : (aGame.cont.pulseIdx >= 0 ? 'warn' : '')}}">
                <text class="bg-conn-t">T+1 / T+2 硬确认 · {{aGame.cont.verdict}}</text>
                <text class="bg-conn-d">{{aGame.cont.text}}</text>
            </view>

            <view class="bg-gates">
                <text class="bg-gates-t">{{aGame.gateVerdict}}</text>
                <view class="bg-gchip {{item.cls}}" wx:for="{{aGame.gateItems}}" wx:key="idx">
                    <text class="bg-gchip-n">{{item.idx}} {{item.name}}</text>
                    <text class="bg-gchip-d">{{item.detail}}</text>
                </view>
            </view>

            <view class="bg-mrow">
                <text class="bg-mlabel">综合动量 M</text>
                <view class="bg-mtrack">
                    <view class="bg-mmark"></view>
                    <view class="bg-mfill {{aGame.mCls}}" style="width:{{aGame.mPct}}%"></view>
                </view>
                <text class="bg-mval num {{aGame.mCls}}">{{aGame.mText}}</text>
            </view>

            <view class="bg-bars">
                <view class="bg-bar" wx:for="{{aGame.bars}}" wx:key="label">
                    <text class="bg-blabel">{{item.label}}</text>
                    <view class="bg-btrack">
                        <view class="bg-bfill {{item.label[0] === 'G' ? 'neg' : ''}}" style="width:{{item.pct}}%"></view>
                        <view class="bg-bmid"></view>
                    </view>
                    <text class="bg-bval num">{{item.text}}</text>
                    <text class="bg-bnote" wx:if="{{item.note}}">{{item.note}}</text>
                </view>
            </view>

            <view class="bg-matrix"><text>{{aGame.matrix}}</text></view>
            <view class="bg-matrix"><text>背离: {{aGame.divergence}}</text></view>

            <view class="bg-quality {{aGame.mUsable ? 'qok' : 'qbad'}}" wx:if="{{aGame.qualityText}}">
                <text>{{aGame.qualityText}}</text>
            </view>

            <view class="bg-policy" wx:if="{{aGame.sourceText}}">
                <text>⚠ {{aGame.sourceText}}</text>
            </view>

            <view class="bg-policy" wx:if="{{aGame.policyText}}">
                <text>政策: {{aGame.policyText}}</text>
            </view>

            <view class="bg-scen" wx:if="{{aGame.scenarios.length}}">
                <text class="bg-scen-t">次日观察框架（脉冲市口径）</text>
                <text class="bg-scen-i" wx:for="{{aGame.scenarios}}" wx:key="*this">{{item}}</text>
            </view>

            <view class="bg-alerts" wx:if="{{aGame.alerts.length}}">
                <text class="bg-alert" wx:for="{{aGame.alerts}}" wx:key="*this">{{item}}</text>
            </view>

            <view class="bg-note">
                <text>{{aGame.date}} 收盘数据 · 情绪=涨停池实数（直连不通时用云端收盘值）；卖压=解禁/高管减持/两融强平/20日乖离四通道；两融·ETF未回填时置中性</text>
                <text>{{'\n'}}参考幅度（连续模型口径，脉冲市里置信度低，仅记录用）：{{aGame.predText}}</text>
                <text wx:if="{{aGame.gateScore < 6}}">{{'\n'}}门禁未全亮 → 明日实操按「只看不买 / 借反抽减仓」执行；出现脉冲放量也不追，等 T+1 不反杀再谈</text>
                <text wx:else>{{'\n'}}门禁全亮 → 可按计划仓位 1/3 小仓试错，止损设前低下方 1%</text>
            </view>
        </view>
        </view>
    </view>

    <view class="card" wx:if="{{verifyPanel}}">
        <view class="sec-head">
            <view class="fold-hit" bindtap="toggleModule" data-key="verify">
                <text class="fold-arrow">{{collapsed.verify ? '展开 ▼' : '收起 ▲'}}</text>
                <text class="sec-label">明日实操验证 · {{verifyPanel.dateLabel}}</text>
            </view>
            <text class="sec-note">{{verifyPanel.stageText}}</text>
        </view>
        <view class="module-body" hidden="{{collapsed.verify}}">
        <view class="vf-verdict vf-verdict-{{verifyPanel.verdict.cls}}" wx:if="{{verifyPanel.verdict}}">
            <view class="vf-verdict-row">
                <text class="vf-verdict-k">今日验证结论</text>
                <text class="vf-verdict-v">{{verifyPanel.verdict.text}}</text>
            </view>
            <text class="vf-verdict-detail">{{verifyPanel.verdict.detail}}</text>
        </view>

        <view class="vf-item vf-{{item.cls}}" wx:for="{{verifyPanel.items}}" wx:key="key">
            <view class="vf-head">
                <text class="vf-title">{{item.title}}</text>
                <text class="vf-badge">{{item.badge}}</text>
            </view>
            <view class="vf-line" wx:for="{{item.lines}}" wx:for-item="ln" wx:key="k">
                <text class="vf-k">{{ln.k}}</text>
                <text class="vf-v num {{ln.cls}}">{{ln.v}}</text>
            </view>
        </view>

        <view class="bg-note">
            <text>模型给的是底牌倾向，盘面给的是实时验证 · 早盘 15 分钟量价结构是验证关键 · 依据上证指数 / 两市同刻量能 / 半导体核心标的（513310 · 159995 · 512480 · 长鑫科技）实时数据</text>
        </view>
        </view>
    </view>

    <view class="card">
        <view class="sec-head">
            <view class="fold-hit" bindtap="toggleModule" data-key="futures">
                <text class="fold-arrow">{{collapsed.futures ? '展开 ▼' : '收起 ▲'}}</text>
                <text class="sec-label">股指期货多空</text>
            </view>
            <view class="head-links">
                <text class="sec-link" bindtap="goAdd">+ 合约</text>
                <text class="sec-link" bindtap="goSetup">录入 ›</text>
            </view>
        </view>

        <view class="module-body" hidden="{{collapsed.futures}}">
        <view class="ls" wx:if="{{longShort.has}}">
            <view class="ls-top">
                <view class="ls-side">
                    <text class="ls-k">前20会员{{longShort.side}}</text>
                    <text class="ls-v num {{longShort.netCls}}">{{longShort.netText}} 手</text>
                </view>
                <view class="ls-side right">
                    <text class="ls-k">较上一日</text>
                    <text class="ls-v num {{longShort.diffCls}}">{{longShort.diffText}}</text>
                </view>
            </view>
            <view class="ls-bar">
                <view class="ls-long" style="width:{{longShort.longPct}}%"></view>
                <view class="ls-short" style="width:{{longShort.shortPct}}%"></view>
            </view>
            <view class="ls-legend">
                <text class="up">多 {{longShort.longPct}}%</text>
                <text class="ls-note">{{longShort.date}} 收盘 · 总持仓 {{longShort.totalText}}</text>
                <text class="down">空 {{longShort.shortPct}}%</text>
            </view>
        </view>

        <view class="ls-empty" wx:else bindtap="goSetup">
            <text class="ls-empty-title">尚未录入多空持仓</text>
            <text class="ls-empty-sub">填入当日「净空单手数」，自动算多空占比与趋势 ›</text>
        </view>

        <view class="fut-table">
            <view class="ft-head">
                <text class="ft-h1">合约</text>
                <text class="ft-h2">最新 / 涨跌</text>
                <text class="ft-h3">基差 / 成交</text>
            </view>
            <view class="ft-row tap" wx:for="{{futures}}" wx:key="label" bindtap="goDetail" data-sec="{{item.sec}}" data-name="{{item.desc}}">
                <view class="ft-name">
                    <text class="ft-code">{{item.label}}</text>
                    <text class="ft-desc">{{item.desc}}</text>
                </view>
                <view class="ft-price">
                    <text class="num ft-p {{item.cls}}">{{item.priceText}}</text>
                    <text class="num ft-pct {{item.cls}}">{{item.pctText}}</text>
                </view>
                <view class="ft-basis">
                    <text class="ft-b {{item.basisCls}}">{{item.basisText}}</text>
                    <text class="ft-vol num">{{item.volText}}</text>
                </view>
            </view>
        </view>

        <view class="pos-box">
            <view class="pos-head">
                <text class="pos-label">净空单 · 中信 vs 前20席位</text>
                <view class="pos-meta">
                    <text class="pos-date num" wx:if="{{posDate}}">截至 {{posDate}} 收盘</text>
                    <text class="pos-src" wx:if="{{posSource}}">{{posSource}}</text>
                </view>
            </view>

            <view class="pos-tabs">
                <text
                    class="pos-tab {{posTab === item.key ? 'on' : ''}}"
                    wx:for="{{posProducts}}"
                    wx:key="key"
                    bindtap="switchPos"
                    data-key="{{item.key}}">{{item.key}} {{item.name}}</text>
            </view>

            <view class="pos-legend">
                <text class="pl-item"><text class="pl-dot solid"></text>中信</text>

.page {
    position: relative;
    min-height: 100vh;
    padding: 24rpx 24rpx 60rpx;
    box-sizing: border-box;
    overflow: hidden;
}

.glow {
    position: fixed;
    top: -260rpx;
    left: -160rpx;
    right: -160rpx;
    height: 620rpx;
    background: radial-gradient(circle at 28% 0%, rgba(64, 132, 226, 0.22), rgba(10, 14, 19, 0) 66%);
    pointer-events: none;
    z-index: 0;
}

.ghead {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 12rpx 8rpx 26rpx;
}

.gh-l {
    display: flex;
    flex-direction: column;
}

.gh-title {
    font-size: 42rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
    color: #f2f6fb;
}

.gh-sub {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #5f6c7d;
    letter-spacing: 1rpx;
}

.gh-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.gh-state {
    display: flex;
    align-items: center;
    gap: 8rpx;
    padding: 6rpx 16rpx;
    border-radius: 100rpx;
    background: rgba(47, 214, 124, 0.1);
    border: 1rpx solid rgba(47, 214, 124, 0.28);
    font-size: 20rpx;
    color: #2fd67c;
}

.gh-state.warn {
    background: rgba(255, 176, 32, 0.1);
    border-color: rgba(255, 176, 32, 0.3);
    color: #ffb020;
}

.gh-dot {
    width: 10rpx;
    height: 10rpx;
    border-radius: 50%;
    background: currentColor;
}

.gh-clock {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #6b7a8d;
}

.srcwarn {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
    margin-bottom: 20rpx;
    padding: 20rpx 22rpx;
    border-radius: 20rpx;
    border: 1rpx solid rgba(255, 176, 32, 0.28);
    background: rgba(255, 176, 32, 0.08);
}

.sw-l {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
}

.sw-t {
    font-size: 22rpx;
    color: #ffcc66;
    line-height: 1.5;
}

.sw-s {
    margin-top: 8rpx;
    font-size: 19rpx;
    color: #8b7a52;
    line-height: 1.5;
}

.sw-btn {
    flex: 0 0 auto;
    padding: 12rpx 18rpx;
    border-radius: 12rpx;
    font-size: 20rpx;
    color: #ffcc66;
    border: 1rpx solid rgba(255, 176, 32, 0.4);
}

.card {
    position: relative;
    z-index: 1;
    margin-bottom: 20rpx;
    padding: 26rpx 26rpx 8rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.055);
    border-radius: 26rpx;
    background: #111721;
}

.card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 16rpx;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.card-title {
    font-size: 27rpx;
    font-weight: 600;
    color: #e8edf4;
    letter-spacing: 1rpx;
}

.card-tag {
    font-size: 19rpx;
    color: #4f5b6b;
    letter-spacing: 1rpx;
}

.q-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 0;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.045);
}

.q-row:last-child {
    border-bottom: none;
}

.q-l {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
    padding-right: 18rpx;
}

.q-name {
    font-size: 26rpx;
    color: #dbe3ee;
}

.q-sub {
    margin-top: 6rpx;
    font-size: 18rpx;
    color: #4f5b6b;
    line-height: 1.4;
}

.q-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex: 0 0 auto;
}

.q-price {
    font-size: 32rpx;
    font-weight: 600;
}

.q-pct {
    margin-top: 6rpx;
    font-size: 21rpx;
}

.foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    padding: 10rpx 12rpx 0;
    font-size: 18rpx;
    color: #414c5b;
    line-height: 1.7;
}

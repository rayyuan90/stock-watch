.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 60rpx;
    background: #0a0e13;
}

.head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 6rpx 8rpx 22rpx;
}

.head-l {
    display: flex;
    flex-direction: column;
}

.h-name {
    font-size: 36rpx;
    font-weight: 700;
    color: #f2f6fb;
}

.h-code {
    margin-top: 8rpx;
    font-size: 20rpx;
    color: #5f6c7d;
}

.head-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.h-price {
    font-size: 38rpx;
    font-weight: 700;
}

.h-pct {
    margin-top: 6rpx;
    font-size: 24rpx;
}

.up { color: #ff6b6d; }
.down { color: #2fd67c; }
.flat { color: #8a97a8; }

.cross {
    margin-bottom: 14rpx;
    padding: 12rpx 16rpx;
    border-radius: 12rpx;
    background: rgba(255, 255, 255, 0.06);
    font-size: 21rpx;
    color: #dfe7f1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cross-tip {
    margin-bottom: 14rpx;
    font-size: 20rpx;
    color: #4b5665;
}

.ksrc {
    margin: -6rpx 0 12rpx;
    font-size: 19rpx;
    color: #6f7d8f;
}

.err {
    padding: 20rpx;
    border-radius: 14rpx;
    background: rgba(255, 77, 79, 0.12);
    color: #ff9a9c;
    font-size: 24rpx;
}

.tabs {
    display: flex;
    margin-bottom: 16rpx;
    border-radius: 14rpx;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
}

.tab {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: 25rpx;
    color: #8a97a8;
}

.tab.on {
    color: #f2f6fb;
    font-weight: 700;
    background: rgba(64, 132, 226, 0.25);
}

.chart-box {
    position: relative;
    height: 620rpx;
    border-radius: 18rpx;
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
}

.chart {
    width: 100%;
    height: 100%;
}

.chart-mask {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16rpx;
    background: rgba(10, 14, 19, 0.7);
    color: #8a97a8;
    font-size: 24rpx;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.15);
    border-top-color: #4084e2;
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.foot {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    margin-top: 26rpx;
    font-size: 20rpx;
    color: #4b5665;
}

/* ---------- 数据源缺失提示 ---------- */
.hint {
    margin-bottom: 14rpx;
    padding: 16rpx 20rpx;
    border-radius: 14rpx;
    background: rgba(230, 184, 76, 0.1);
    border: 1rpx solid rgba(230, 184, 76, 0.25);
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.hint-t {
    font-size: 23rpx;
    color: #e6b84c;
}

.hint-s {
    font-size: 19rpx;
    color: #8a7a4f;
    line-height: 1.5;
}

/* ---------- 盘前 / 盘后 ---------- */
.ext-bar {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin: 0 0 18rpx;
    padding: 0 4rpx;
}

.eb-item {
    font-size: 21rpx;
    padding: 4rpx 14rpx;
    border-radius: 100rpx;
    background: rgba(255, 255, 255, 0.05);
    color: #9aa7b8;
}

.eb-item.up {
    color: #ff6b6d;
    background: rgba(255, 77, 79, 0.12);
}

.eb-item.down {
    color: #2fd67c;
    background: rgba(23, 201, 100, 0.12);
}

.eb-note {
    font-size: 18rpx;
    color: #414c5a;
}

.page {
    position: relative;
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 60rpx;
    background: #0a0e13;
}

.glow {
    position: fixed;
    top: -260rpx;
    left: -160rpx;
    right: -160rpx;
    height: 620rpx;
    background: radial-gradient(circle at 28% 0%, rgba(64, 132, 226, 0.22), rgba(10, 14, 19, 0) 66%);
    pointer-events: none;
    z-index: 0;
}

.topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 10rpx 8rpx 24rpx;
}

.tb-left {
    display: flex;
    flex-direction: column;
}

.tb-title {
    font-size: 38rpx;
    font-weight: 700;
    color: #f2f6fb;
    letter-spacing: 1rpx;
}

.tb-sub {
    margin-top: 8rpx;
    font-size: 21rpx;
    color: #5f6c7d;
}

.clock {
    font-size: 22rpx;
    color: #4f5b6b;
}

.err {
    position: relative;
    z-index: 1;
    margin-bottom: 16rpx;
    padding: 16rpx 20rpx;
    border-radius: 14rpx;
    background: rgba(230, 184, 76, 0.1);
    color: #d9b46a;
    font-size: 22rpx;
}

.card {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 26rpx 26rpx 22rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.055);
    border-radius: 26rpx;
    background: #111721;
}

.sec-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14rpx;
}

.sec-label {
    font-size: 27rpx;
    font-weight: 600;
    color: #dfe7f1;
    letter-spacing: 1rpx;
}

.sec-note {
    font-size: 20rpx;
    color: #4f5b6b;
}

/* ---------- 头部汇总 ---------- */
.head-row {
    display: flex;
    justify-content: space-between;
}

.hc {
    display: flex;
    flex-direction: column;
    flex: 1;
    align-items: center;
}

.hc:first-child {
    align-items: flex-start;
}

.hc:last-child {
    align-items: flex-end;
}

.hc-k {
    font-size: 20rpx;
    color: #5f6c7d;
}

.hc-v {
    margin-top: 8rpx;
    font-size: 32rpx;
    font-weight: 700;
    color: #e9f0f8;
}

.hc-d {
    margin-top: 6rpx;
    font-size: 19rpx;
    color: #414c5a;
}

.flow-bar {
    position: relative;
    margin-top: 24rpx;
    height: 14rpx;
    border-radius: 100rpx;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
}

.fb-fill {
    height: 100%;
    border-radius: 100rpx;
    background: linear-gradient(90deg, #2f6bd8, #6c9bff);
    transition: width 0.4s;
}

.flow-note {
    display: block;
    margin-top: 14rpx;
    font-size: 20rpx;
    color: #56637a;
}

/* ---------- 读数条 ---------- */
.cross {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14rpx;
    margin-bottom: 12rpx;
    padding: 10rpx 16rpx;
    border-radius: 12rpx;
    background: rgba(255, 255, 255, 0.045);
    font-size: 21rpx;
    color: #c9d6e5;
}

.cx-t {
    color: #e9f0f8;
    font-weight: 600;
}

.cx-i {
    color: #9aa7b8;
}

.cx-i.up {
    color: #ff6b6d;
}

.cx-i.down {
    color: #2fd67c;
}

.cross-tip {
    margin-bottom: 12rpx;
    font-size: 19rpx;
    color: #414c5a;
}

/* ---------- 图表 ---------- */
.chart-box {
    position: relative;
    width: 100%;
    height: 400rpx;
}

.chart-box.tall {
    height: 460rpx;
}

.chart {
    width: 100%;
    height: 100%;
}

.foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10rpx;
    padding: 10rpx 10rpx 0;
    font-size: 20rpx;
    color: #414c5a;
    line-height: 1.6;
}

.loading-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 14, 19, 0.82);
    z-index: 9;
}

.loading-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18rpx;
    color: #8a97a8;
    font-size: 24rpx;
}

.spinner {
    width: 52rpx;
    height: 52rpx;
    border: 4rpx solid rgba(255, 255, 255, 0.12);
    border-top-color: #6c9bff;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.page {
    position: relative;
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 60rpx;
    background: #0a0e13;
}

.glow {
    position: fixed;
    top: -260rpx;
    left: -160rpx;
    right: -160rpx;
    height: 620rpx;
    background: radial-gradient(circle at 28% 0%, rgba(64, 132, 226, 0.22), rgba(10, 14, 19, 0) 66%);
    pointer-events: none;
    z-index: 0;
}

.topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 10rpx 8rpx 24rpx;
}

.tb-left {
    display: flex;
    flex-direction: column;
}

.tb-title {
    font-size: 38rpx;
    font-weight: 700;
    color: #f2f6fb;
    letter-spacing: 1rpx;
}

.tb-sub {
    margin-top: 8rpx;
    font-size: 21rpx;
    color: #5f6c7d;
}

.clock {
    font-size: 22rpx;
    color: #4f5b6b;
}

.card {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 26rpx 26rpx 22rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.055);
    border-radius: 26rpx;
    background: #111721;
}

.sec-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14rpx;
}

.sec-label {
    font-size: 27rpx;
    font-weight: 600;
    color: #dfe7f1;
}

.sec-note {
    font-size: 20rpx;
    color: #4f5b6b;
}

/* ---------- 统计 ---------- */
.stat-row {
    display: flex;
    justify-content: space-between;
}

.st {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
}

.st:first-child {
    align-items: flex-start;
}

.st:last-child {
    align-items: flex-end;
}

.st-k {
    font-size: 20rpx;
    color: #5f6c7d;
}

.st-v {
    margin-top: 8rpx;
    font-size: 32rpx;
    font-weight: 700;
    color: #e9f0f8;
}

.rule {
    display: block;
    margin-top: 20rpx;
    font-size: 19rpx;
    color: #4b5665;
    line-height: 1.7;
}

/* ---------- 读数条 ---------- */
.cross {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14rpx;
    margin-bottom: 12rpx;
    padding: 10rpx 16rpx;
    border-radius: 12rpx;
    background: rgba(255, 255, 255, 0.045);
    font-size: 21rpx;
    color: #c9d6e5;
}

.cx-t {
    color: #e9f0f8;
    font-weight: 600;
}

.cx-i {
    color: #9aa7b8;
}

.cx-i.up {
    color: #ff6b6d;
}

.cx-i.down {
    color: #2fd67c;
}

.cx-hit {
    margin-left: auto;
    font-size: 21rpx;
    font-weight: 600;
}

.cx-hit.ok {
    color: #5ec26a;
}

.cx-hit.bad {
    color: #ff6b6d;
}

.cx-hit.flat {
    color: #5f6c7d;
}

.cross-tip {
    margin-bottom: 12rpx;
    font-size: 19rpx;
    color: #414c5a;
}

/* ---------- 图表 ---------- */
.chart-box {
    position: relative;
    width: 100%;
    height: 440rpx;
}

.chart {
    width: 100%;
    height: 100%;
}

/* ---------- 逐日列表 ---------- */
.hrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 0;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.hrow:last-child {
    border-bottom: none;
}

.h-date {
    width: 110rpx;
    font-size: 24rpx;
    color: #9aa7b8;
}

.h-score {
    width: 130rpx;
    font-size: 26rpx;
    font-weight: 600;
    text-align: center;
}

.h-open {
    flex: 1;
    font-size: 24rpx;
    text-align: center;
}

.h-hit {
    width: 90rpx;
    font-size: 21rpx;
    text-align: right;
}

.h-hit.ok {
    color: #5ec26a;
}

.h-hit.bad {
    color: #ff6b6d;
}

.h-hit.flat {
    color: #414c5a;
}

/* ---------- 空态 ---------- */
.empty {
    display: flex;
    flex-direction: column;
    padding: 24rpx 6rpx 20rpx;
}

.empty-t {
    font-size: 26rpx;
    color: #8a97a8;
}

.empty-s {
    margin-top: 10rpx;
    font-size: 21rpx;
    color: #4b5665;
    line-height: 1.6;
}

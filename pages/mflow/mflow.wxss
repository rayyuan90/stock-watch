.page {
    min-height: 100vh;
    background: #10141b;
    padding: 24rpx 24rpx 60rpx;
    box-sizing: border-box;
    color: #dbe3ee;
}

.glow {
    position: fixed;
    top: -200rpx;
    left: -120rpx;
    width: 520rpx;
    height: 520rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(106, 169, 233, 0.14) 0%, transparent 70%);
    pointer-events: none;
}

.hhead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin: 8rpx 4rpx 20rpx;
}

.hh-title {
    display: block;
    font-size: 38rpx;
    font-weight: 600;
    color: #f2f6fb;
    letter-spacing: 2rpx;
}

.hh-sub {
    display: block;
    font-size: 21rpx;
    color: #6b7a8d;
    margin-top: 6rpx;
}

.hh-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8rpx;
}

.hh-state {
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 20rpx;
    color: #5fc78f;
}

.hh-state.warn {
    color: #e8b45a;
}

.hh-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: currentColor;
}

.hh-clock {
    font-size: 20rpx;
    color: #6b7a8d;
}

.warnbar {
    background: rgba(232, 180, 90, 0.12);
    border: 1rpx solid rgba(232, 180, 90, 0.3);
    border-radius: 14rpx;
    padding: 16rpx 20rpx;
    font-size: 21rpx;
    color: #e8b45a;
    margin-bottom: 20rpx;
    line-height: 1.5;
}

.card {
    background: rgba(255, 255, 255, 0.035);
    border: 1rpx solid rgba(255, 255, 255, 0.07);
    border-radius: 22rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.card-title {
    font-size: 27rpx;
    font-weight: 600;
    color: #f2f6fb;
}

.card-tag {
    font-size: 19rpx;
    color: #6b7a8d;
}

/* ---- 四类图例 ---- */
.lg-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}

.lg-item {
    flex: 1 1 calc(50% - 10rpx);
    min-width: calc(50% - 10rpx);
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    gap: 16rpx;
    background: rgba(255, 255, 255, 0.03);
    border: 1rpx solid rgba(255, 255, 255, 0.06);
    border-radius: 16rpx;
    padding: 20rpx;
}

.lg-dot {
    flex: 0 0 auto;
    width: 20rpx;
    height: 20rpx;
    border-radius: 6rpx;
    margin-top: 10rpx;
}

.lg-body {
    flex: 1 1 auto;
}

.lg-line1 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
}

.lg-name {
    font-size: 26rpx;
    color: #eef3f9;
    font-weight: 600;
}

.lg-val {
    font-size: 30rpx;
    font-weight: 700;
}

.lg-sub {
    display: block;
    font-size: 19rpx;
    color: #6b7a8d;
    margin-top: 6rpx;
}

.up { color: #e2506a; }
.down { color: #34a06a; }

/* ---- 分市场明细 ---- */
.pt-head,
.pt-row {
    display: flex;
    align-items: center;
}

.pt-head {
    font-size: 19rpx;
    color: #6b7a8d;
    padding-bottom: 12rpx;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.pt-row {
    padding: 16rpx 0;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.pt-row:last-child {
    border-bottom: none;
}

.pt-name {
    flex: 0 0 150rpx;
    font-size: 22rpx;
    color: #cfd8e3;
}

.pt-col {
    flex: 1 1 auto;
    text-align: right;
    font-size: 21rpx;
}

.pt-head .pt-col {
    color: #6b7a8d;
}

.empty {
    text-align: center;
    color: #6b7a8d;
    font-size: 23rpx;
    padding: 50rpx 0;
}

.tip {
    font-size: 19rpx;
    color: #55636f;
    line-height: 1.6;
    margin-top: 8rpx;
    padding: 0 6rpx;
}

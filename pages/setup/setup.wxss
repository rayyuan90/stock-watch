.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 200rpx;
    background: #0a0e13;
}

.glow {
    position: fixed;
    top: -260rpx;
    left: -160rpx;
    right: -160rpx;
    height: 560rpx;
    background: radial-gradient(circle at 30% 0%, rgba(64, 132, 226, 0.2), rgba(10, 14, 19, 0) 66%);
    pointer-events: none;
}

.intro {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 12rpx 8rpx 26rpx;
}

.intro-title {
    font-size: 40rpx;
    font-weight: 700;
    color: #f2f6fb;
}

.intro-sub {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #5f6c7d;
}

.cloud-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
    padding: 22rpx 24rpx;
    border: 1rpx solid rgba(108, 155, 255, 0.18);
    border-radius: 22rpx;
    background: rgba(108, 155, 255, 0.06);
}

.cc-info {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.cc-k {
    font-size: 19rpx;
    color: #4f5b6b;
    letter-spacing: 1rpx;
}

.cc-v {
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #9fc0ff;
}

.cc-err {
    margin-top: 8rpx;
    font-size: 19rpx;
    color: #ff8b8c;
    line-height: 1.5;
}

.cc-btn {
    margin: 0 0 0 20rpx;
    padding: 0 24rpx;
    height: 62rpx;
    border-radius: 14rpx;
    background: linear-gradient(135deg, #3d7bf0, #2c5fd0);
    color: #ffffff;
    font-size: 22rpx;
    line-height: 62rpx;
}

.cc-btn::after {
    border: none;
}

.card {
    position: relative;
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 26rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.055);
    border-radius: 26rpx;
    background: #111721;
}

.card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #dfe7f1;
}

.card-tag {
    padding: 4rpx 14rpx;
    border-radius: 100rpx;
    background: rgba(255, 180, 84, 0.1);
    color: #d99444;
    font-size: 19rpx;
}

.card-desc {
    margin-top: 12rpx;
    font-size: 21rpx;
    color: #4f5b6b;
    line-height: 1.65;
}

.field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 0;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.field:last-child {
    border-bottom: none;
    padding-bottom: 4rpx;
}

.f-label {
    font-size: 25rpx;
    color: #9aa7b8;
}

.f-right {
    display: flex;
    align-items: center;
}

.f-input {
    width: 260rpx;
    color: #f2f6fb;
    font-size: 28rpx;
    text-align: right;
}

.f-unit {
    margin-left: 12rpx;
    font-size: 20rpx;
    color: #4f5b6b;
}

.ph {
    color: #333d49;
}

.side-switch {
    display: flex;
    margin: 22rpx 0 4rpx;
    padding: 6rpx;
    border-radius: 14rpx;
    background: rgba(255, 255, 255, 0.04);
}

.side-btn {
    flex: 1;
    padding: 14rpx 0;
    border-radius: 10rpx;
    color: #6f7d8f;
    font-size: 23rpx;
    text-align: center;
}

.side-btn.active-short {
    background: rgba(255, 77, 79, 0.16);
    color: #ff6b6d;
}

.side-btn.active-long {
    background: rgba(23, 201, 100, 0.16);
    color: #2fd67c;
}

.picker-val {
    padding: 8rpx 18rpx;
    border-radius: 10rpx;
    background: rgba(255, 255, 255, 0.05);
    color: #c3ccda;
    font-size: 25rpx;
}

.hint {
    padding: 20rpx 24rpx;
    border-radius: 18rpx;
    background: rgba(255, 255, 255, 0.025);
    font-size: 20rpx;
    color: #4a5563;
    line-height: 1.75;
}

.save-bar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 20rpx 24rpx 40rpx;
    background: linear-gradient(180deg, rgba(10, 14, 19, 0), #0a0e13 40%);
}

.save-btn {
    height: 92rpx;
    border-radius: 20rpx;
    background: linear-gradient(135deg, #3d7bf0, #2c5fd0);
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 92rpx;
}

.save-btn::after {
    border: none;
}

/* ---------- 网络自检 ---------- */
.diag-btn {
    margin-top: 16rpx;
    padding: 18rpx 0;
    border-radius: 14rpx;
    text-align: center;
    background: rgba(106, 169, 233, 0.14);
    border: 1rpx solid rgba(106, 169, 233, 0.3);
    font-size: 24rpx;
    color: #8fc0f0;
}

.diag-btn:active {
    background: rgba(106, 169, 233, 0.24);
}

.diag-list {
    margin-top: 14rpx;
}

.diag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14rpx 0;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.diag-row:last-child {
    border-bottom: none;
}

.dr-l {
    display: flex;
    flex-direction: column;
    gap: 4rpx;
}

.dr-host {
    font-size: 22rpx;
    color: #d6dde7;
}

.dr-label {
    font-size: 18rpx;
    color: #5f6c7d;
}

.dr-r {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4rpx;
}

.dr-ok {
    font-size: 21rpx;
    padding: 2rpx 14rpx;
    border-radius: 100rpx;
}

.dr-ok.pass {
    color: #2fd67c;
    background: rgba(47, 214, 124, 0.12);
}

.dr-ok.fail {
    color: #ff6b6d;
    background: rgba(255, 107, 109, 0.12);
}

.dr-detail {
    font-size: 18rpx;
    color: #5f6c7d;
}
